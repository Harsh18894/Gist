# Backend (optional)
# GIST_DB_PATH=backend/gist.sqlite3
# Set v2 and change GIST_DB_PATH to backend/gist-v2.sqlite3 together.
GIST_DATASET_VERSION=v1
GIST_CORS_ORIGIN=http://localhost:3000
# Frontend (optional, public API URL; no secrets)
NEXT_PUBLIC_GIST_API_URL=http://localhost:8000
# Phase 2 demo works with no key and no paid calls.
GIST_ENABLE_PAID_API=false
# Set true only after the user explicitly approves the bounded validation run.
GIST_PAID_EVAL_APPROVED=false
# The application also enforces an absolute $0.50 project-wide allocation.
GIST_MAX_API_SPEND_USD=0
# Optional persistent ledger location (default backend/gist-spend.sqlite3).
# GIST_SPEND_DB_PATH=backend/gist-spend.sqlite3
GIST_LLM_MODEL=gpt-6-luna
# Only after explicit approval: set OPENAI_API_KEY server-side.
# OPENAI_API_KEY=
# When changing GIST_LLM_MODEL, set both prices to the current official USD/1M-token rates.
# GIST_LLM_INPUT_USD_PER_M=
# GIST_LLM_OUTPUT_USD_PER_M=
# --- Public demo (Phase 5; set in the hosting dashboard, never commit real values)
# GIST_PUBLIC_MODE=true            # read-only demo + per-IP rate limits
# GIST_TRUST_PROXY=true            # behind Render's proxy
# GIST_PUBLIC_AI=false             # visitor AI only behind the access code, limits and a daily cap
# GIST_PUBLIC_AI_ACCESS_CODE=      # at least 12 characters; share with reviewers only
# GIST_PUBLIC_AI_DAILY_USD=0.10
# GIST_PUBLIC_AI_PER_HOUR=3
# GIST_PUBLIC_AI_PER_DAY=10
